<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arka_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- BARRA SUPERIOR -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/btnVolverPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_card_dark"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="← Volver"
                android:textColor="@color/arka_text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Editar Perfil"
                android:textColor="@color/arka_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- AVATAR Y DATOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card_dark"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvPerfilAvatarGrande"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/ricardo"
                android:gravity="center"
                android:textColor="@color/arka_text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPerfilTituloNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Miguel"
                android:textColor="@color/arka_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPerfilSubtituloEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="usuario@arka.com"
                android:textColor="@color/arka_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- CAMPOS EDITABLES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Nombre completo"
            android:textColor="@color/arka_text_primary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPerfilNombre"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_dark"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Correo electrónico"
            android:textColor="@color/arka_text_primary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPerfilEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_dark"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Contacto de confianza (Emergencias)"
            android:textColor="@color/arka_purple_light"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etContactoEmergencia"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_input_dark"
            android:hint="+57 300 000 0000"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:textColor="@color/arka_text_primary"
            android:textColorHint="#6B7280"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGuardarPerfil"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Guardar Cambios"
            android:textAllCaps="false"
            android:textColor="@color/arka_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>