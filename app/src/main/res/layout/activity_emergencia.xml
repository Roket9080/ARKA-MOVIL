<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_arka"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ENCABEZADO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/fondo_tarjeta">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/angel"
                android:contentDescription="Ángel de ARKA"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="ARKA | Emergencias"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- PRESENTACIÓN -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:text="ATENCIÓN INMEDIATA"
            android:textColor="#FB7185"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Atención de emergencia"
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Encuentra ayuda y acompañamiento en momentos de crisis emocional."
            android:textColor="#A5A1B2"
            android:textSize="15sp"
            android:gravity="center"/>

        <!-- PANEL DE EMERGENCIA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☎"
                android:textColor="#FB7185"
                android:textSize="48sp"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="¿Estás en peligro inmediato?"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Si tu vida o tu seguridad está en riesgo, comunícate con emergencias o acude al servicio de urgencias más cercano."
                android:textColor="#A5A1B2"
                android:textSize="14sp"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="123"
                android:textColor="#FB7185"
                android:textSize="38sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <Button
                android:id="@+id/btnLlamar123"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:backgroundTint="#BE123C"
                android:text="Llamar a emergencias - 123"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:minHeight="55dp"/>

        </LinearLayout>

        <!-- LÍNEA DE SALUD MENTAL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Línea de salud mental"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Servicio de orientación psicológica y acompañamiento emocional, según disponibilidad en tu región."
                android:textColor="#A5A1B2"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnLlamar106"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="#793CD1"
                android:text="Llamar al 106"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:minHeight="55dp"/>

        </LinearLayout>

        <!-- CONTACTO DE CONFIANZA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contacto de confianza"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Comunícate con un familiar, amigo o persona de confianza y pídele que te acompañe."
                android:textSize="14sp"
                android:textColor="#A5A1B2"/>

        </LinearLayout>

        <!-- REGRESAR A LA PRIMERA PANTALLA -->

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Volver a atención en salud"
            android:textAllCaps="false"
            android:backgroundTint="#393044"
            android:textColor="#FFFFFF"
            android:minHeight="55dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="25dp"
            android:text="ARKA | Tu vida importa"
            android:gravity="center"
            android:textColor="#858095"
            android:textSize="12sp"/>

    </LinearLayout>

</ScrollView>
