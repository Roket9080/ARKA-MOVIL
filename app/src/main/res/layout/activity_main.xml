<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arka_bg_primary"
    android:fillViewport="true"
    android:padding="16dp">

    <!-- Tarjeta contenedora principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_arka_card"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado: Logo + Nombre ARKA -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/arka_purple_light"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:id="@+id/ivLogoArka"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Logo ARKA"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo_arka" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvNombreMarca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="ARKA"
                android:textColor="@color/arka_purple_light"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Título principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Evaluación Emocional"
            android:textColor="@color/arka_purple_light"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Campo: Usuario -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Usuario"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUsuario"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_arka_input"
            android:inputType="textPersonName"
            android:paddingHorizontal="14dp"
            android:textColor="@color/arka_text_primary"
            android:textColorHint="@color/arka_text_secondary"
            android:textSize="14sp" />

        <!-- Campo: Profesional -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Profesional"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfesional"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_arka_input"
            android:inputType="textPersonName"
            android:paddingHorizontal="14dp"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp" />

        <!-- Campo: Estado afectivo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Estado afectivo"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEstadoAfectivo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_arka_input"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp" />

        <!-- Desplegable: Nivel de riesgo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Nivel de riesgo"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_arka_input">

            <Spinner
                android:id="@+id/spNivelRiesgo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:entries="@array/niveles_riesgo"
                android:paddingStart="10dp"
                android:paddingEnd="36dp"
                android:spinnerMode="dropdown" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:contentDescription="Desplegar"
                android:src="@android:drawable/arrow_down_float"
                app:tint="@color/arka_text_primary" />
        </FrameLayout>

        <!-- Área de texto: Necesidades detectadas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Necesidades detectadas"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNecesidades"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_arka_input"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp" />

        <!-- Área de texto: Observaciones -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Observaciones"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etObservaciones"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_arka_input"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp" />

        <!-- Área de texto: Recomendaciones -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Recomendaciones"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRecomendaciones"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_arka_input"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/arka_text_primary"
            android:textSize="14sp" />

        <!-- Botón Guardar evaluación -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGuardarEvaluacion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_btn_evaluacion"
            android:text="Guardar evaluación"
            android:textAllCaps="false"
            android:textColor="@color/arka_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>