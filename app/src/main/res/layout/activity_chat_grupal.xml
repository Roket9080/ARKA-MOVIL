<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <!-- 1. Barra superior con botón Volver y nombre del grupo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0E4B6E"
        android:padding="14dp">

        <Button
            android:id="@+id/btnVolverGrupal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:textAllCaps="false"
            android:backgroundTint="#1F7FB0"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grupo: Manejo de Ansiedad"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="12 participantes · Moderador activo"
                android:textSize="12sp"
                android:textColor="#D0E4F0" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Zona central de mensajes (ocupa todo el espacio sobrante con weight="1") -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Mensaje de un usuario joven -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:text="Usuario #14:\nÚltimamente me cuesta dormir pensando en los exámenes..."
            android:textColor="#0C1419"
            android:textSize="14sp" />

        <!-- Intervención del psicólogo (alineada a la derecha con layout_gravity="end") -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:background="#D9EDF7"
            android:padding="12dp"
            android:text="Psicólogo (Tú):\nHola, gracias por compartirlo. Vamos a revisar juntos una técnica de respiración."
            android:textColor="#0E4B6E"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 3. Barra inferior para escribir y enviar intervención -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="10dp">

        <EditText
            android:id="@+id/edtMensajeGrupal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Escribe una orientación al grupo..."
            android:inputType="textMultiLine"
            android:maxLines="3" />

        <Button
            android:id="@+id/btnEnviarGrupal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Enviar"
            android:textAllCaps="false"
            android:backgroundTint="#0E4B6E"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>