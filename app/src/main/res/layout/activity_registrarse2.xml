<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arka_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ENCABEZADO SUPERIOR: LOGO ÁNGEL + ARKA -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivLogoRegister"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Logo ARKA"
                    android:scaleType="centerCrop"
                    android:src="@drawable/angel" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:letterSpacing="0.06"
                android:text="ARKA"
                android:textColor="@color/arka_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TÍTULO: CREAR CUENTA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crea tu cuenta"
            android:textColor="@color/arka_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="3dp"
            android:text="Tu información es 100% confidencial y protegida."
            android:textColor="@color/arka_text_secondary"
            android:textSize="14sp" />

        <!-- CAMPO NOMBRE COMPLETO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Nombre completo"
            android:textColor="@color/arka_text_primary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etRegNombre"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_dark"
            android:hint="Ej. Miguel Quiñonez"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="@color/arka_text_primary"
            android:textColorHint="#6B7280"
            android:textSize="14sp" />

        <!-- NUEVO APARTADO: NOMBRE DE USUARIO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Nombre de usuario"
            android:textColor="@color/arka_text_primary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etRegUsuario"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_dark"
            android:hint="Ej. @miguel_arka"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="@color/arka_text_primary"
            android:textColorHint="#6B7280"
            android:textSize="14sp" />

        <!-- CAMPO CORREO ELECTRÓNICO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Correo electrónico"
            android:textColor="@color/arka_text_primary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etRegEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_dark"
            android:hint="ejemplo@correo.com"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/arka_text_primary"
            android:textColorHint="#6B7280"
            android:textSize="14sp" />

        <!-- CAMPO CONTRASEÑA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Contraseña"
            android:textColor="@color/arka_text_primary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etRegPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_input_dark"
            android:hint="Mínimo 6 caracteres"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/arka_text_primary"
            android:textColorHint="#6B7280"
            android:textSize="14sp" />

        <!-- BOTÓN COMPLETAR REGISTRO -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Completar Registro"
            android:textAllCaps="false"
            android:textColor="@color/arka_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- ENLACE A INICIAR SESIÓN -->
        <TextView
            android:id="@+id/tvIrALogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="¿Ya tienes cuenta? Inicia sesión"
            android:textColor="@color/arka_purple_light"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>